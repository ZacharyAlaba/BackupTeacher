# Copy this file to .env and fill in real values.
# .env is git-ignored, so it does NOT transfer between machines via git pull/clone —
# you must copy it manually (or recreate it) on every machine you run this app on.

# Postgres connection (Supabase). Get these from Supabase project settings > Database.
DATABASE_URL="postgresql://username:password@host:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://username:password@host:5432/postgres"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Optional: set to "true" to force demo/local accounts instead of the real DB
DEMO_AUTH_ENABLED="false"

# Optional: email OTP sending (2FA)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Optional: used only by scripts/upsert-admin.ts
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Admin User"
